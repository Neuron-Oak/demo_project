    "nodes": [
      {
        "key": "cust_auth_access",
        "type_slug": "customer-requirement",
        "title": "Fleet staff access the platform securely",
        "status": "approved",
        "container": "feat_auth",
        "statement": "Fleet managers, dispatchers and drivers shall access FleetPilot through secure authentication with role-appropriate permissions.",
        "tags": ["seed", "must-have"]
      },
      {
        "key": "req_sso",
        "type_slug": "sw-requirement",
        "title": "Users authenticate via SSO (OIDC)",
        "status": "approved",
        "container": "feat_auth",
        "statement": "Users shall authenticate via OpenID Connect SSO with the organization identity provider. Session tokens shall expire after at most 8 hours of inactivity.",
        "tags": ["seed", "must-have"]
      },
      {
        "key": "req_rbac",
        "type_slug": "sw-requirement",
        "title": "Role-based access: admin / dispatcher / driver",
        "status": "approved",
        "container": "feat_auth",
        "statement": "The system shall enforce role-based access with at least admin, dispatcher, and driver roles. Drivers shall only see their assigned vehicles.",
        "tags": ["seed", "must-have"]
      },
      {
        "key": "req_mfa_admin",
        "type_slug": "sw-requirement",
        "title": "MFA enforced for admin accounts",
        "status": "submitted",
        "container": "feat_auth",
        "statement": "Admin accounts shall require a second factor at every login.",
        "tags": ["seed"]
      },
