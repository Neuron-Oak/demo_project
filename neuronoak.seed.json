        "key": "req_can_readonly",
        "type_slug": "hw-requirement",
        "title": "CAN-bus read-only interface",
        "status": "approved",
        "container": "feat_telematics",
        "statement": "The unit shall expose a read-only CAN-bus interface; write frames to the vehicle bus are forbidden.",
        "tags": ["seed"]
      },
      {
        "key": "req_power_budget",
        "type_slug": "hw-requirement",
        "title": "Standby power ≤ 0.5 W",
        "status": "approved",
        "container": "feat_telematics",
        "statement": "The telematics unit shall draw at most 0.5 W in ignition-off standby mode.",
