        "key": "rsk_session_fixation",
        "type_slug": "risk",
        "title": "Session fixation risk",
        "status": "submitted",
        "container": "feat_auth",
        "tags": ["seed"]
      },

      {
        "key": "cust_live_map",
        "type_slug": "customer-requirement",
        "title": "Dispatchers see vehicles live on a map",
        "status": "approved",
        "container": "scope_tracking",
        "statement": "As a dispatcher I shall see all active vehicles on a live map with status indicators so I can react to delays and offline units.",
        "tags": ["seed", "must-have"]
      },
      {
        "key": "req_position_latency",
        "type_slug": "sys-requirement",
        "title": "Positions update ≤ 5 s latency",
        "status": "approved",
        "container": "scope_tracking",
        "statement": "Vehicle position updates shall be visible in the live map within 5 seconds of the telematics unit sending a fix under normal network conditions.",
        "tags": ["seed", "must-have"]
      },
      {
        "key": "req_websocket_fanout",
        "type_slug": "sw-requirement",
        "title": "WebSocket fan-out",
        "status": "approved",
        "container": "scope_tracking",
        "statement": "Position events shall be fan-out to subscribed clients via WebSocket with at-most-once delivery semantics.",
        "tags": ["seed"]
      },
      {
        "key": "req_map_clustering",
        "type_slug": "sw-requirement",
        "title": "Map clusters ≥ 50 vehicles",
        "status": "submitted",
        "container": "scope_tracking",
        "statement": "The live map shall cluster markers when more than 50 vehicles are visible in the viewport.",
        "tags": ["seed"]
      },
      {
        "key": "req_offline_flag",
        "type_slug": "sw-requirement",
        "title": "Offline vehicles flagged after 60 s",
        "status": "submitted",
        "container": "scope_tracking",
        "statement": "Vehicles with no position update for 60 seconds shall be marked offline in the UI and API.",
        "tags": ["seed"]
      },
